# Copy to .env for local runs (.env is gitignored), or set these in the
# Render dashboard under Environment. Never commit real values.

# Required. From @BotFather.
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Health-check port. Render injects this automatically.
PORT=10000

# Optional. DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
